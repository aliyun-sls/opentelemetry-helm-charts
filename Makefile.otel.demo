# ===================================================================
# OpenTelemetry Demo 部署 Makefile
# ===================================================================

# 配置变量
ACR_REGISTRY ?= o11y-demo-registry.cn-hongkong.cr.aliyuncs.com
ACR_NAMESPACE ?= o11y-demo
CHART_VERSION ?= 0.37.2
K8S_NAMESPACE ?= opentelemetry-demo
RELEASE_NAME ?= otel-demo
CHART_NAME ?= opentelemetry-demo
CHART_PATH = charts/$(CHART_NAME)
VALUES_FILE = $(CHART_PATH)/values.yaml
OUTPUT_DIR = ./helm-packages

# ACR 凭据 (可选的环境变量)
ACR_USERNAME ?= 
ACR_PASSWORD ?= 

# 颜色定义
RED = \033[0;31m
GREEN = \033[0;32m
YELLOW = \033[1;33m
BLUE = \033[0;34m
MAGENTA = \033[0;35m
CYAN = \033[0;36m
NC = \033[0m

# 默认目标
.DEFAULT_GOAL := help

# 帮助信息
.PHONY: help
help: ## 显示帮助信息
	@echo "$(MAGENTA)🚀 OpenTelemetry Demo ACR 部署工具$(NC)"
	@echo ""
	@echo "$(CYAN)可用命令:$(NC)"
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z0-9_-]+:.*?## / {printf "  $(YELLOW)%-20s$(NC) %s\n", $$1, $$2}' $(MAKEFILE_LIST)
	@echo ""
	@echo "$(CYAN)配置参数:$(NC)"
	@echo "  $(YELLOW)ACR_REGISTRY$(NC)     = $(ACR_REGISTRY)"
	@echo "  $(YELLOW)ACR_NAMESPACE$(NC)    = $(ACR_NAMESPACE)"
	@echo "  $(YELLOW)CHART_VERSION$(NC)    = $(CHART_VERSION)"
	@echo "  $(YELLOW)K8S_NAMESPACE$(NC)    = $(K8S_NAMESPACE)"
	@echo "  $(YELLOW)RELEASE_NAME$(NC)     = $(RELEASE_NAME)"
	@if [ -n "$(ACR_USERNAME)" ]; then \
		echo "  $(YELLOW)ACR_USERNAME$(NC)     = $(ACR_USERNAME) $(GREEN)(已设置)$(NC)"; \
	else \
		echo "  $(YELLOW)ACR_USERNAME$(NC)     = $(RED)(未设置，将使用交互输入)$(NC)"; \
	fi
	@if [ -n "$(ACR_PASSWORD)" ]; then \
		echo "  $(YELLOW)ACR_PASSWORD$(NC)     = $(GREEN)(已设置)$(NC)"; \
	else \
		echo "  $(YELLOW)ACR_PASSWORD$(NC)     = $(RED)(未设置，将使用交互输入)$(NC)"; \
	fi
	@echo ""
	@echo "$(CYAN)使用示例:$(NC)"
	@echo "  make -f Makefile.otel.demo prepare"
	@echo "  make -f Makefile.otel.demo install-local"
	@echo "  make -f Makefile.otel.demo full-deploy RELEASE_NAME=prod-demo"
	@echo ""
	@echo "$(CYAN)自动化部署 (无交互):$(NC)"
	@echo "  ACR_USERNAME=user ACR_PASSWORD=pass make -f Makefile.otel.demo full-deploy"

# 1. 准备阶段
.PHONY: prepare
prepare: ## 1️⃣ 准备阶段：创建命名空间和 ACR Secret
	@echo "$(MAGENTA)🎯 Step 1: 准备阶段 - 创建 ACR Secret$(NC)"
	@echo "$(GREEN)创建 K8s 命名空间...$(NC)"
	@kubectl create namespace $(K8S_NAMESPACE) --dry-run=client -o yaml | kubectl apply -f -
	@echo "$(GREEN)创建 ACR 镜像拉取 Secret...$(NC)"
	@if [ -z "$(ACR_USERNAME)" ] || [ -z "$(ACR_PASSWORD)" ]; then \
		echo "$(YELLOW)请输入您的 ACR 凭据:$(NC)"; \
		if [ -z "$(ACR_USERNAME)" ]; then \
			read -p "ACR 用户名: " ACR_USERNAME_INPUT; \
		else \
			ACR_USERNAME_INPUT="$(ACR_USERNAME)"; \
			echo "ACR 用户名: $$ACR_USERNAME_INPUT $(GREEN)(来自环境变量)$(NC)"; \
		fi; \
		if [ -z "$(ACR_PASSWORD)" ]; then \
			read -s -p "ACR 密码: " ACR_PASSWORD_INPUT; \
			echo ""; \
		else \
			ACR_PASSWORD_INPUT="$(ACR_PASSWORD)"; \
			echo "ACR 密码: $(GREEN)(来自环境变量)$(NC)"; \
		fi; \
	else \
		ACR_USERNAME_INPUT="$(ACR_USERNAME)"; \
		ACR_PASSWORD_INPUT="$(ACR_PASSWORD)"; \
		echo "$(GREEN)使用环境变量中的 ACR 凭据$(NC)"; \
	fi; \
	kubectl create secret docker-registry acr-secret \
		--docker-server=$(ACR_REGISTRY) \
		--docker-username=$$ACR_USERNAME_INPUT \
		--docker-password=$$ACR_PASSWORD_INPUT \
		--docker-email=demo@example.com \
		--namespace=$(K8S_NAMESPACE) \
		--dry-run=client -o yaml | kubectl apply -f -
	@echo "$(GREEN)✅ ACR Secret 创建成功$(NC)"

# 2. 本地测试
.PHONY: test-local
test-local: ## 2️⃣ 本地测试：验证 chart 配置
	@echo "$(MAGENTA)🎯 Step 2: 本地测试阶段$(NC)"
	@echo "$(GREEN)检查 Helm 是否安装...$(NC)"
	@if ! command -v helm &> /dev/null; then \
		echo "$(RED)❌ Helm 未安装，请先安装 Helm$(NC)"; \
		exit 1; \
	fi
	@echo "$(GREEN)✅ Helm 版本: $$(helm version --short)$(NC)"
	@echo "$(GREEN)添加必要的 Helm 仓库...$(NC)"
	@helm repo add open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts || true
	@helm repo add jaegertracing https://jaegertracing.github.io/helm-charts || true
	@helm repo add prometheus-community https://prometheus-community.github.io/helm-charts || true
	@helm repo add grafana https://grafana.github.io/helm-charts || true
	@helm repo add opensearch https://opensearch-project.github.io/helm-charts || true
	@echo "$(GREEN)更新 Helm 仓库...$(NC)"
	@helm repo update
	@echo "$(GREEN)✅ Helm 仓库配置完成$(NC)"
	@echo "$(GREEN)构建 Chart 依赖...$(NC)"
	@cd $(CHART_PATH) && helm dependency build
	@echo "$(GREEN)✅ 依赖构建成功$(NC)"
	@echo "$(GREEN)验证 Chart 语法...$(NC)"
	@helm lint $(CHART_PATH) --values $(VALUES_FILE)
	@echo "$(GREEN)✅ Chart 语法检查通过$(NC)"
	@echo "$(GREEN)生成模板预览...$(NC)"
	@mkdir -p $(OUTPUT_DIR)/template-preview
	@helm template $(RELEASE_NAME) $(CHART_PATH) \
		--values $(VALUES_FILE) \
		--namespace $(K8S_NAMESPACE) \
		--output-dir $(OUTPUT_DIR)/template-preview
	@echo "$(GREEN)✅ 模板生成成功，输出目录: $(OUTPUT_DIR)/template-preview$(NC)"

# 3. 打包阶段
.PHONY: package
package: ## 3️⃣ 打包阶段：生成 helm chart 包
	@echo "$(MAGENTA)🎯 Step 3: 打包阶段$(NC)"
	@mkdir -p $(OUTPUT_DIR)
	@echo "$(GREEN)检查并构建 Chart 依赖...$(NC)"
	@cd $(CHART_PATH); \
	if [ -f "Chart.yaml" ] && grep -q "dependencies:" "Chart.yaml"; then \
		echo "$(YELLOW)发现 Chart 依赖，正在配置仓库...$(NC)"; \
		helm repo add open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts || true; \
		helm repo add jaegertracing https://jaegertracing.github.io/helm-charts || true; \
		helm repo add prometheus-community https://prometheus-community.github.io/helm-charts || true; \
		helm repo add grafana https://grafana.github.io/helm-charts || true; \
		helm repo add opensearch https://opensearch-project.github.io/helm-charts || true; \
		helm repo update; \
		echo "$(YELLOW)正在构建依赖...$(NC)"; \
		helm dependency build; \
		echo "$(GREEN)✅ 依赖构建成功$(NC)"; \
	else \
		echo "$(CYAN)ℹ️  无需构建依赖$(NC)"; \
	fi
	@echo "$(GREEN)打包 Helm Chart...$(NC)"
	@helm package $(CHART_PATH) --version $(CHART_VERSION) --destination $(OUTPUT_DIR)
	@PACKAGE_FILE="$(OUTPUT_DIR)/$(CHART_NAME)-$(CHART_VERSION).tgz"; \
	if [ -f "$$PACKAGE_FILE" ]; then \
		echo "$(GREEN)✅ Chart 打包成功: $$PACKAGE_FILE$(NC)"; \
		SIZE=$$(du -h "$$PACKAGE_FILE" | cut -f1); \
		echo "$(CYAN)📦 包大小: $$SIZE$(NC)"; \
	else \
		echo "$(RED)❌ 打包文件未找到$(NC)"; \
		exit 1; \
	fi

# 4. 推送到 ACR
.PHONY: push-to-acr
push-to-acr: package ## 4️⃣ 推送阶段：推送到阿里云 ACR
	@echo "$(MAGENTA)🎯 Step 4: 推送到 ACR 阶段$(NC)"
	@PACKAGE_FILE="$(OUTPUT_DIR)/$(CHART_NAME)-$(CHART_VERSION).tgz"; \
	if [ ! -f "$$PACKAGE_FILE" ]; then \
		echo "$(RED)❌ 打包文件不存在: $$PACKAGE_FILE，请先执行打包步骤$(NC)"; \
		exit 1; \
	fi
	@echo "$(GREEN)登录到 ACR...$(NC)"
	@if [ -z "$(ACR_USERNAME)" ] || [ -z "$(ACR_PASSWORD)" ]; then \
		echo "$(YELLOW)请输入您的 ACR 凭据:$(NC)"; \
		if [ -z "$(ACR_USERNAME)" ]; then \
			read -p "ACR 用户名: " ACR_USERNAME_INPUT; \
		else \
			ACR_USERNAME_INPUT="$(ACR_USERNAME)"; \
			echo "ACR 用户名: $$ACR_USERNAME_INPUT $(GREEN)(来自环境变量)$(NC)"; \
		fi; \
		if [ -z "$(ACR_PASSWORD)" ]; then \
			read -s -p "ACR 密码: " ACR_PASSWORD_INPUT; \
			echo ""; \
		else \
			ACR_PASSWORD_INPUT="$(ACR_PASSWORD)"; \
			echo "ACR 密码: $(GREEN)(来自环境变量)$(NC)"; \
		fi; \
	else \
		ACR_USERNAME_INPUT="$(ACR_USERNAME)"; \
		ACR_PASSWORD_INPUT="$(ACR_PASSWORD)"; \
		echo "$(GREEN)使用环境变量中的 ACR 凭据$(NC)"; \
	fi; \
	echo "$$ACR_PASSWORD_INPUT" | helm registry login $(ACR_REGISTRY) --username $$ACR_USERNAME_INPUT --password-stdin
	@echo "$(GREEN)✅ ACR 登录成功$(NC)"
	@echo "$(GREEN)推送 Chart 到 ACR...$(NC)"
	@ACR_CHART_URL="oci://$(ACR_REGISTRY)/$(ACR_NAMESPACE)"; \
	helm push $(OUTPUT_DIR)/$(CHART_NAME)-$(CHART_VERSION).tgz $$ACR_CHART_URL
	@echo "$(GREEN)✅ Chart 推送成功到: oci://$(ACR_REGISTRY)/$(ACR_NAMESPACE)$(NC)"

# 5. 本地安装
.PHONY: install-local
install-local: ## 5️⃣ 本地安装：从本地 chart 安装
	@echo "$(MAGENTA)🎯 Step 5: 本地安装 - 从本地 Chart 安装$(NC)"
	@if helm list -n $(K8S_NAMESPACE) | grep -q "^$(RELEASE_NAME)"; then \
		echo "$(YELLOW)⚠️  Release '$(RELEASE_NAME)' 已存在，将执行升级...$(NC)"; \
		INSTALL_CMD="upgrade"; \
	else \
		echo "$(GREEN)🆕 Release '$(RELEASE_NAME)' 不存在，将执行安装...$(NC)"; \
		INSTALL_CMD="install"; \
	fi; \
	echo "$(GREEN)使用 helm $$INSTALL_CMD 从本地 Chart 部署...$(NC)"; \
	if [ "$$INSTALL_CMD" = "install" ]; then \
		helm install $(RELEASE_NAME) $(CHART_PATH) \
			--namespace $(K8S_NAMESPACE) \
			--create-namespace \
			--values $(VALUES_FILE) \
			--timeout 10m \
			--wait; \
	else \
		helm upgrade $(RELEASE_NAME) $(CHART_PATH) \
			--namespace $(K8S_NAMESPACE) \
			--values $(VALUES_FILE) \
			--timeout 10m \
			--wait; \
	fi
	@echo "$(GREEN)✅ 部署成功！$(NC)"
	@$(MAKE) -f Makefile.otel.demo show-status

# 6. ACR 安装
.PHONY: install-acr
install-acr: ## 6️⃣ ACR安装：从 ACR 仓库安装
	@echo "$(MAGENTA)🎯 Step 6: ACR 安装 - 从 ACR 仓库安装$(NC)"
	@if helm list -n $(K8S_NAMESPACE) | grep -q "^$(RELEASE_NAME)"; then \
		echo "$(YELLOW)⚠️  Release '$(RELEASE_NAME)' 已存在，将执行升级...$(NC)"; \
		INSTALL_CMD="upgrade"; \
	else \
		echo "$(GREEN)🆕 Release '$(RELEASE_NAME)' 不存在，将执行安装...$(NC)"; \
		INSTALL_CMD="install"; \
	fi; \
	ACR_CHART_URL="oci://$(ACR_REGISTRY)/$(ACR_NAMESPACE)/$(CHART_NAME)"; \
	echo "$(GREEN)使用 helm $$INSTALL_CMD 从 ACR 仓库部署...$(NC)"; \
	echo "$(CYAN)Chart 地址: $$ACR_CHART_URL$(NC)"; \
	echo "$(CYAN)版本: $(CHART_VERSION)$(NC)"; \
	if [ "$$INSTALL_CMD" = "install" ]; then \
		helm install $(RELEASE_NAME) $$ACR_CHART_URL \
			--version $(CHART_VERSION) \
			--namespace $(K8S_NAMESPACE) \
			--create-namespace \
			--values $(VALUES_FILE) \
			--timeout 10m \
			--wait; \
	else \
		helm upgrade $(RELEASE_NAME) $$ACR_CHART_URL \
			--version $(CHART_VERSION) \
			--namespace $(K8S_NAMESPACE) \
			--values $(VALUES_FILE) \
			--timeout 10m \
			--wait; \
	fi
	@echo "$(GREEN)✅ 部署成功！$(NC)"
	@$(MAKE) -f Makefile.otel.demo show-status

# 显示部署状态
.PHONY: show-status
show-status: ## 📊 显示部署状态
	@echo ""
	@echo "$(CYAN)📊 部署状态检查:$(NC)"
	@helm status $(RELEASE_NAME) -n $(K8S_NAMESPACE)
	@echo ""
	@echo "$(CYAN)🔍 Pod 状态:$(NC)"
	@kubectl get pods -n $(K8S_NAMESPACE)
	@echo ""
	@echo "$(CYAN)🌐 Service 状态:$(NC)"
	@kubectl get svc -n $(K8S_NAMESPACE)
	@echo ""
	@echo "$(GREEN)🚀 访问应用:$(NC)"
	@echo "$(YELLOW)端口转发命令 (在另一个终端执行):$(NC)"
	@echo "$(CYAN)kubectl port-forward -n $(K8S_NAMESPACE) svc/frontend-proxy 8080:8080$(NC)"
	@echo "$(YELLOW)然后访问: http://localhost:8080$(NC)"

# 显示手动命令
.PHONY: show-commands
show-commands: ## 📋 显示手动 helm install 命令
	@echo "$(CYAN)📋 手动 Helm Install 命令参考$(NC)"
	@echo ""
	@echo "$(MAGENTA)🎯 方式一：从本地 Chart 安装$(NC)"
	@echo "helm install $(RELEASE_NAME) $(CHART_PATH) \\"
	@echo "    --namespace $(K8S_NAMESPACE) \\"
	@echo "    --create-namespace \\"
	@echo "    --values $(VALUES_FILE) \\"
	@echo "    --timeout 10m \\"
	@echo "    --wait"
	@echo ""
	@echo "$(MAGENTA)🎯 方式二：从 ACR OCI 仓库安装$(NC)"
	@echo "# 1. 首先登录 ACR"
	@echo "helm registry login $(ACR_REGISTRY) --username <username>"
	@echo ""
	@echo "# 2. 安装应用"
	@echo "helm install $(RELEASE_NAME) oci://$(ACR_REGISTRY)/$(ACR_NAMESPACE)/$(CHART_NAME) \\"
	@echo "    --version $(CHART_VERSION) \\"
	@echo "    --namespace $(K8S_NAMESPACE) \\"
	@echo "    --create-namespace \\"
	@echo "    --values $(VALUES_FILE) \\"
	@echo "    --timeout 10m \\"
	@echo "    --wait"

# 卸载应用
.PHONY: uninstall
uninstall: ## 🗑️ 卸载已部署的应用
	@echo "$(MAGENTA)🗑️  卸载应用: $(RELEASE_NAME)$(NC)"
	@if ! helm list -n $(K8S_NAMESPACE) | grep -q "^$(RELEASE_NAME)"; then \
		echo "$(YELLOW)⚠️  Release '$(RELEASE_NAME)' 不存在$(NC)"; \
		exit 0; \
	fi
	@echo "$(GREEN)执行 helm uninstall...$(NC)"
	@helm uninstall $(RELEASE_NAME) -n $(K8S_NAMESPACE)
	@echo "$(GREEN)✅ 应用卸载成功$(NC)"

# 完整部署流程
.PHONY: full-deploy
full-deploy: ## 🎯 完整流程：执行所有步骤
	@echo "$(MAGENTA)🚀 开始完整部署流程...$(NC)"
	@$(MAKE) -f Makefile.otel.demo prepare
	@$(MAKE) -f Makefile.otel.demo test-local
	@$(MAKE) -f Makefile.otel.demo package
	@$(MAKE) -f Makefile.otel.demo push-to-acr
	@$(MAKE) -f Makefile.otel.demo install-acr
	@echo ""
	@echo "$(GREEN)🎉 完整部署流程成功完成！$(NC)"

# 清理
.PHONY: clean
clean: ## 🧹 清理生成的文件
	@echo "$(GREEN)清理输出目录...$(NC)"
	@rm -rf $(OUTPUT_DIR)
	@echo "$(GREEN)✅ 清理完成$(NC)" 